{
  "name": "ergalics-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Ergalics Studio - A browser-based scientific computing workstation framework",
  "license": "MIT",
  "author": "SnowLeopard-io <1486853830@qq.com>",
  "workspaces": [
    "docs",
    "website"
  ],
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "build": "npm run build:wasm && tsc --noEmit && vite build && node scripts/build-docs.mjs",
    "build:web": "node scripts/make-wasm-stub.mjs && tsc --noEmit && vite build && node scripts/build-docs.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:website": "npm run build --prefix website",
    "deploy:merge": "node scripts/merge-deploy.mjs",
    "build:android": "node scripts/android-build.mjs",
    "build:android:release": "node scripts/android-build.mjs --release",
    "build:linux": "node scripts/linux-build.mjs",
    "docs:dev": "npm run dev --prefix docs",
    "docs:preview": "npm run preview --prefix docs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "lint:eslint": "eslint .",
    "sync": "node scripts/sync-push.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-run.mjs",
    "l4:report": "vitest run tests/acceptance/l4.test.ts",
    "l4:gate": "node scripts/l4-gate.mjs",
    "verify": "npm run typecheck && npm test",
    "verify:site": "node scripts/verify-site.mjs --merge",
    "bench": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs && node scripts/bench-report.mjs",
    "bench:ci": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs --env-baseline && node scripts/bench-report.mjs --env-baseline",
    "bench:update": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs --update-baseline && node scripts/bench-report.mjs",
    "build:report": "node scripts/build-budget.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@isomorphic-git/lightning-fs": "^4.10.5",
    "@tensorflow/tfjs": "^4.22.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apache-arrow": "^21.2.0",
    "blockly": "^13.5.0",
    "buffer": "^6.0.3",
    "dompurify": "^3.5.0",
    "fflate": "^0.8.2",
    "fitsjs": "^0.6.6",
    "h5wasm": "^0.10.3",
    "isomorphic-git": "^1.44.18",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "lz-string": "^1.5.0",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.58.0",
    "netcdfjs": "^4.0.0",
    "parquet-wasm": "^0.9.0",
    "pyodide": "^314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "svg2pdf.js": "^2.9.0",
    "three": "^0.187.0",
    "zarrita": "^0.7.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "argparse": "2.0.1"
  },
  "trustedDependencies": [
    "core-js"
  ]
}
