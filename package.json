{
  "name": "ergalics-studio",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "Ergalics Studio - A browser-based scientific computing workstation framework",
  "license": "MIT",
  "author": "SnowLeopard-io <1486853830@qq.com>",
  "workspaces": [
    "docs",
    "website"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build && node scripts/build-docs.mjs",
    "build:web": "tsc --noEmit && vite build && node scripts/build-docs.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:website": "npm run build --prefix website",
    "deploy:merge": "node scripts/merge-deploy.mjs",
    "docs:dev": "npm run dev --prefix docs",
    "docs:preview": "npm run preview --prefix docs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "lint:eslint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-run.mjs",
    "verify": "npm run typecheck && npm test",
    "verify:site": "node scripts/verify-site.mjs --merge",
    "bench": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs && node scripts/bench-report.mjs",
    "bench:ci": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs --env-baseline && node scripts/bench-report.mjs --env-baseline",
    "bench:update": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs --update-baseline && node scripts/bench-report.mjs",
    "build:report": "node scripts/build-budget.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@tensorflow/tfjs": "^4.22.0",
    "apache-arrow": "^21.2.0",
    "blockly": "^13.2.1",
    "fflate": "^0.8.2",
    "fitsjs": "^0.6.6",
    "h5wasm": "^0.10.3",
    "jspdf": "^4.2.1",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.52.2",
    "netcdfjs": "^4.0.0",
    "parquet-wasm": "^0.7.2",
    "pyodide": "^314.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.185.1",
    "uuid": "^11.0.3",
    "zarrita": "^0.7.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "^1.62.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
