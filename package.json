{
  "name": "ergalics-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ergalics Studio - 浏览器端专业科学计算工作站工业化脚手架",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke-test.mjs && node scripts/verify-ui.mjs && node scripts/verify-fixes.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "three": "^0.185.1",
    "uuid": "^11.0.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/lz-string": "^1.5.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.62.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
