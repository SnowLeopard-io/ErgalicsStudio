{
  "name": "ergalics-studio",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Ergalics Studio - Monorepo for the scientific computing workstation, plugin ecosystem, website, and docs",
  "license": "MIT",
  "author": "SnowLeopard-io <1486853830@qq.com>",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @ergalics/studio dev",
    "dev:all": "turbo run dev --parallel",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "build": "pnpm run build:wasm && turbo run typecheck && turbo run build --filter=@ergalics/studio && node scripts/build-docs.mjs",
    "build:web": "node scripts/make-wasm-stub.mjs && turbo run typecheck --filter=@ergalics/studio... && turbo run build --filter=@ergalics/studio && node scripts/build-docs.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "build:website": "turbo run build --filter=@ergalics/website",
    "deploy:merge": "node scripts/merge-deploy.mjs",
    "build:android": "node scripts/android-build.mjs",
    "build:android:release": "node scripts/android-build.mjs --release",
    "build:linux": "node scripts/linux-build.mjs",
    "docs:dev": "pnpm --filter @ergalics/docs dev",
    "docs:preview": "pnpm --filter @ergalics/docs preview",
    "preview": "pnpm --filter @ergalics/studio preview",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && turbo run typecheck",
    "lint:eslint": "eslint .",
    "sync": "node scripts/sync-push.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-run.mjs",
    "l4:report": "vitest run tests/acceptance/l4.test.ts",
    "l4:gate": "node scripts/l4-gate.mjs",
    "verify": "pnpm run typecheck && pnpm test",
    "verify:site": "node scripts/verify-site.mjs --merge",
    "bench": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs && node scripts/bench-report.mjs",
    "bench:ci": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs --env-baseline && node scripts/bench-report.mjs --env-baseline",
    "bench:update": "node --expose-gc scripts/bench-run.mjs && node scripts/bench-compare.mjs --update-baseline && node scripts/bench-report.mjs",
    "build:report": "node scripts/build-budget.mjs"
  },
  "devDependencies": {
    "@ergalics/plugin-sdk": "workspace:*",
    "@ergalics/plugin-signing": "workspace:*",
    "@ergalics/plugins": "workspace:*",
    "@ergalics/sci-kernels": "workspace:*",
    "@ergalics/studio": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@isomorphic-git/lightning-fs": "^4.10.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "apache-arrow": "^21.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "fflate": "^0.8.2",
    "fitsjs": "^0.6.6",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "three": "^0.187.0",
    "turbo": "^2.5.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.6.7"
  }
}
