{
  "name": "ergalics-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ergalics Studio - A browser-based scientific computing workstation framework",
  "license": "MIT",
  "author": "SnowLeopard-io <1486853830@qq.com>",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build && node scripts/build-docs.mjs",
    "build:web": "tsc --noEmit && vite build && node scripts/build-docs.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "docs:dev": "npm run dev --prefix docs",
    "docs:preview": "npm run preview --prefix docs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke-test.mjs && node scripts/verify-ui.mjs && node scripts/verify-fixes.mjs && node scripts/verify-3d.mjs && node scripts/verify-plugins.mjs && node scripts/verify-webgpu.mjs && node scripts/verify-block-mode.mjs && node scripts/verify-code-mode.mjs && node scripts/verify-ai-samples.mjs && node scripts/verify-ai-training.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "blockly": "^13.2.1",
    "fflate": "^0.8.2",
    "fitsjs": "^0.6.6",
    "h5wasm": "^0.10.3",
    "jspdf": "^4.2.1",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.52.2",
    "netcdfjs": "^4.0.0",
    "parquet-wasm": "^0.7.2",
    "pyodide": "^314.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.185.1",
    "uuid": "^11.0.3",
    "zarrita": "^0.7.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/lz-string": "^1.5.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.62.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
