# Fresh-checkout installs
# -----------------------
# This is an npm workspaces monorepo: `docs` pins a vitepress alpha and
# `website` shares React/Vite with the app. Their strict peer ranges differ
# between npm versions, and npm 10+ can abort the entire install with
# ERESOLVE on a source-only checkout (no node_modules). The resolved tree in
# package-lock.json is already verified, so ignore peer-range re-resolution
# and install exactly what the lockfile specifies.
legacy-peer-deps=true
