# pnpm workspace install policy
# -----------------------------
# Strict node_modules isolation (shamefully-hoist=false) guarantees every
# package under packages/* declares its own dependencies explicitly — essential
# so packages/plugins stays extraction-ready as a future standalone repo.
# auto-install-peers=true + strict-peer-dependencies=false prevents peer-range
# friction across VitePress (docs) and React/Vite (studio & website).
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
