node_modules/
dist/
target/
pkg/
.native/
*.log
.DS_Store
.idea/
.vscode/
coverage/
.cspkg
*.clproj
# Sample project files under examples/projects/ are part of the repo — they
# are loaded at build time by src/blocks/sample.ts (import.meta.glob) to power
# the Flow-mode sample picker. User-saved projects elsewhere stay ignored.
!examples/projects/*.clproj
# WASM build artifacts emitted into src/native/ by scripts/build-wasm.mjs.
# Regenerated on demand (`npm run build:wasm` / `npm run build`); keeping
# them untracked avoids binary merge conflicts in multi-developer repos.
src/native/ergalics_core.js
src/native/ergalics_core_bg.wasm

# Vendored Pyodide (core + numpy wheel) for the code-mode runtime. Copied from
# the `pyodide` npm package + downloaded once by scripts/copy-pyodide.mjs; kept
# out of git so the repo carries no ~25MB of binaries. Regenerated on dev/build.
public/pyodide/

# Vendored Blockly media (sprite sheet + interaction sounds). Copied from
# node_modules/blockly/media by scripts/vendor-blockly-media.mjs so block
# mode never fetches from static.blockly.com. Regenerated on dev/build.
public/blockly/

# Scratch space: demo-video recording scripts/screenshots, temp experiment
# output and test logs. Kept locally for reuse, never committed.
tmp/

# Renamed-away stale build output awaiting manual deletion.
dist-stale-*/

# Throwaway build-verification output dirs (created while validating the
# Pyodide vendoring change). Not real artifacts.
dist-verify*

.workbuddy/

# Local npm mirror registry (npmmirror) — a machine-local preference that
# must not be committed: every contributor and CI would be forced onto the
# mirror. Configure it in ~/.npmrc instead.
.npmrc

# Docs workspace (VitePress): dependencies and build artifacts.
docs/node_modules/
docs/.vitepress/*
!docs/.vitepress/config.mts
prd.md
插件需求.md
ergalics-studio-poster/