node_modules/
dist/
# math 分布插件（概率分布）源码目录：.gitignore 里的 dist/ 会误伤它，这里收回
!src/plugins/builtin/math/dist/
target/
pkg/
.native/
*.log
# Python bytecode caches (regenerated on every interpreter run; tracking them
# causes binary diff noise and stale-cache churn across Python versions).
__pycache__/
*.py[cod]
.DS_Store
.idea/
.vscode/
# TRAE IDE HTML preview/share packaging cache (regenerated on demand).
.trae-html-share-packages/
coverage/
.cspkg
*.clproj
# Sample project files under examples/projects/ are part of the repo — they
# are loaded at build time by src/blocks/sample.ts (import.meta.glob) to power
# the Flow-mode sample picker. User-saved projects elsewhere stay ignored.
!examples/projects/*.clproj
# WASM build artifacts emitted into src/native/ by scripts/build-wasm.mjs.
# Regenerated on demand (`npm run build:wasm` / `npm run build`); keeping
# them untracked avoids binary merge conflicts in multi-developer repos.
src/native/ergalics_core.js
src/native/ergalics_core_bg.wasm

# Vendored Pyodide (core + numpy wheel) for the code-mode runtime. Copied from
# the `pyodide` npm package + downloaded once by scripts/copy-pyodide.mjs; kept
# out of git so the repo carries no ~25MB of binaries. Regenerated on dev/build.
public/pyodide/

# Vendored Blockly media (sprite sheet + interaction sounds). Copied from
# node_modules/blockly/media by scripts/vendor-blockly-media.mjs so block
# mode never fetches from static.blockly.com. Regenerated on dev/build.
public/blockly/

# Scratch space: demo-video recording scripts/screenshots, temp experiment
# output and test logs. Kept locally for reuse, never committed.
tmp/
# Browser/recorder screenshot scratch dir (recreated on demand).
.screenshots/

.trae/

# Renamed-away stale build output awaiting manual deletion.
dist-stale-*/

# Throwaway build-verification output dirs (created while validating the
# Pyodide vendoring change). Not real artifacts.
dist-verify*

.workbuddy/

# Machine-local npm preferences (mirror registry, tokens) belong in ~/.npmrc,
# never in the repo. The committed .npmrc is token-free and only carries the
# workspace install policy (legacy-peer-deps), so a source-only checkout can
# run `npm install` on any npm version without ERESOLVE aborts.

# Docs workspace (VitePress): dependencies and build artifacts.
docs/node_modules/
docs/.vitepress/*
!docs/.vitepress/config.mts
!docs/.vitepress/research-blocks.mjs
# The hand-written VitePress custom theme (Layout.vue, cross-site.css, ...) is
# source code — it implements the cross-site nav switcher and must be tracked.
# Only the generated build output under dist/ stays ignored.
!docs/.vitepress/theme/
!docs/.vitepress/theme/**

# Official website (npm workspace): build output.
website/dist/

# Merged GitHub Pages artifact (website root + workstation under app/),
# produced by scripts/merge-deploy.mjs. Regenerated on every deploy build.
pages-out/

# FR-23 benchmark run outputs (regenerated by `npm run bench`; the committed
# baseline lives in bench/baseline.json).
bench-results.json
bench-report.html
prd.md
插件需求.md
em-pde-plugin-prd.md
ergalics-studio-poster/
em-mode-3d-preview.png
ai_cfd_zXnsRXJxwR.pdf
ergalics-studio-optimization-prd.md

promo/
# Jarvis agent workspace artifacts
.jarvis/

# Desktop (Electron) Windows edition build artifacts — produced by the
# windows build toolchain (not tracked in this repo). Only deploy/windows/src,
# deploy/windows/resources and the packaging config are tracked.
deploy/windows/node_modules/
deploy/windows/dist-electron/
deploy/windows/app-dist/
deploy/windows/release/
deploy/windows/build-dist.log
# Portable CPython bundled into the installer (downloaded on demand).
deploy/windows/resources/python/

# Android (Capacitor) build artifacts. The native project sources are tracked;
# web assets are copied in by `npm run build:android` / `cap sync` each time.
deploy/android/node_modules/
deploy/android/app-dist/
deploy/android/release/
deploy/android/android/.gradle/
deploy/android/android/local.properties
deploy/android/android/app/build/
deploy/android/android/app/src/main/assets/public/
deploy/android/android/app/src/main/assets/capacitor.config.json


industrial-capability-benchmark/